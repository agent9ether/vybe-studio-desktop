{
  "include": ["electron/**/*.ts", "shared/**/*.ts", "electron.vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "paths": { "@shared/*": ["./shared/*"] }
  }
}
